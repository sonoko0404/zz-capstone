# Copy this file to backend/.env. Never expose these values to the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DOTENV_OVERRIDE=true
ENABLE_REAL_JIRA=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Real Jira Cloud (used only when ENABLE_REAL_JIRA=true)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
ITO_PROJECT_KEY=ITO
BIM_PROJECT_KEY=BIM
ITO_ISSUE_TYPE=Task
BIM_ISSUE_TYPE=Story
JIRA_LINK_TYPE=Relates
